APP_NAME="CND Manager Sandbox"
APP_KEY=base64:3gzbmf3AgL+68pZofZev7+ZGquXZrHRPKzRzJv4IYzw=

# =============================================================================
#  SANDBOX PROFILE — disposable local database + storage for trying out risky
#  features (Excel import, backup/restore with attachment bundling) against
#  fake seeded data. Never points at the real cnd_manager database or the
#  real storage/app/{private,public} directories.
#
#  Usage:
#    php artisan migrate:fresh --seed --env=sandbox
#    php artisan serve --env=sandbox --port=8010
#
#  Provision the database first with scripts/postgres-provision-sandbox.sql.
# =============================================================================

APP_ENV=sandbox
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_SSLMODE=prefer

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cnd_manager_sandbox
DB_USERNAME=postgres
DB_PASSWORD=Naser?2026
DB_OWNER_DATABASE=cnd_manager_sandbox
DB_OWNER_USERNAME=cnd_owner
DB_OWNER_PASSWORD=CndOwner?2026
DB_READONLY_DATABASE=cnd_manager_sandbox
DB_READONLY_USERNAME=cnd_readonly
DB_READONLY_PASSWORD=CndRead?2026

BACKUP_STORAGE_DISK=local
BACKUP_DIRECTORY=database-backups-sandbox

# Isolated on-disk storage — separate from the real app's storage/app/private
# and storage/app/public, so sandbox attachment uploads/backups never mix
# with real files even though both point at "disk local/public".
LOCAL_STORAGE_ROOT="C:\\Users\\GIS\\Desktop\\NCM-manager\\BackEnd\\storage\\app\\private-sandbox"
PUBLIC_STORAGE_ROOT="C:\\Users\\GIS\\Desktop\\NCM-manager\\BackEnd\\storage\\app\\public-sandbox"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=cnd_manager_sandbox_cache

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
