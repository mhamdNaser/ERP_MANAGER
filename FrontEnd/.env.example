# Copy to .env. The real .env keeps two blocks, [LOCAL] and [SERVER], with
# exactly one uncommented — see FrontEnd/.env for the layout.
#
# Use /api while developing through Vite's proxy.
# For production, this may be a full URL such as https://api.example.com/api.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000

# Development server settings. These are ignored by the production build.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
VITE_DEV_SERVER_HOST=127.0.0.1
VITE_DEV_SERVER_PORT=5173
VITE_REVERB_ENABLED=true
VITE_REVERB_APP_KEY=cnd-local-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
