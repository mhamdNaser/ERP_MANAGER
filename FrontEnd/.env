# =============================================================================
#  CND Manager — front-end environment
#  -----------------------------------------------------------------------
#  Two blocks below: [LOCAL] and [SERVER]. Exactly ONE must be uncommented.
#
#    On the development machine  ->  [LOCAL]  active, [SERVER] commented.
#    On the deployment server    ->  [SERVER] active, [LOCAL]  commented.
#
#  Current profile: LOCAL
# =============================================================================

VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=300000
VITE_DEV_SERVER_HOST=127.0.0.1
VITE_DEV_SERVER_PORT=5173
VITE_REVERB_ENABLED=true
VITE_REVERB_APP_KEY=cnd-local-key
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- [LOCAL] ------------------------------------------------------------ ON
VITE_DEV_API_TARGET=http://127.0.0.1:8000
VITE_REVERB_HOST=127.0.0.1

# --- [SERVER] ---------------------------------------------------------- OFF
# VITE_DEV_API_TARGET=http://172.16.0.21
# VITE_REVERB_HOST=172.16.0.21
